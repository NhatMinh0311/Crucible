# Biến môi trường cho dịch vụ phụ thuộc khi phát triển (dev/compose.yaml).
# Sao chép thành dev/.env. Giá trị dưới đây chỉ dùng cho máy phát triển.

POSTGRES_PASSWORD=postgres-dev
RUNTIME_DB_PASSWORD=runtime-dev
CONTENT_DB_PASSWORD=content-dev
LEARNING_DB_PASSWORD=learning-dev
KEYCLOAK_DB_PASSWORD=keycloak-dev

RABBITMQ_USER=crucible
RABBITMQ_PASSWORD=rabbitmq-dev

KEYCLOAK_ADMIN_PASSWORD=admin-dev

# Cổng trên máy phát triển; đổi khi bị trùng với dịch vụ khác.
DB_PORT=5432
AMQP_PORT=5672
RABBITMQ_UI_PORT=15672
KEYCLOAK_PORT=8180
S3_PORT=8333
SMTP_PORT=1025
MAILPIT_UI_PORT=8025
