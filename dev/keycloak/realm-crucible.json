{
  "realm": "crucible",
  "enabled": true,
  "displayName": "Crucible",
  "sslRequired": "none",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "internationalizationEnabled": true,
  "supportedLocales": [
    "vi",
    "en"
  ],
  "defaultLocale": "vi",
  "accessTokenLifespan": 900,
  "roles": {
    "realm": [
      {
        "name": "STUDENT",
        "description": "Học viên"
      },
      {
        "name": "INSTRUCTOR",
        "description": "Giảng viên"
      },
      {
        "name": "ADMIN",
        "description": "Quản trị nền tảng"
      }
    ]
  },
  "defaultRole": {
    "name": "default-roles-crucible",
    "composite": true,
    "composites": {
      "realm": [
        "offline_access",
        "uma_authorization",
        "STUDENT"
      ],
      "client": {
        "account": [
          "view-profile",
          "manage-account"
        ]
      }
    }
  },
