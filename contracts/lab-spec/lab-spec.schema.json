{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://crucible.dev/schemas/lab-spec/v1.json",
  "title": "Đặc tả bài lab Crucible v1",
  "description": "Lược đồ của một phiên bản bài lab. Các trường có ghi 'Mẫu' được kết xuất tham số theo cú pháp {{tên}} trước khi sử dụng (CR-DOC-03 mục 4).",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "metadata", "environment", "steps", "solution"],
  "properties": {
    "apiVersion": { "const": "crucible.dev/v1" },
    "kind": { "const": "Lab" },
    "metadata": { "$ref": "#/$defs/metadata" },
    "params": {
      "description": "Tham số sinh riêng cho mỗi học viên. Khóa là tên tham số.",
      "type": "object",
      "maxProperties": 20,
      "propertyNames": { "$ref": "#/$defs/identifier" },
      "additionalProperties": { "$ref": "#/$defs/param" }
    },
    "constraints": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "distinct": {
          "description": "Mỗi phần tử là một nhóm tham số phải nhận giá trị khác nhau từng đôi.",
          "type": "array",
          "items": {
            "type": "array",
            "minItems": 2,
            "uniqueItems": true,
            "items": { "$ref": "#/$defs/identifier" }
          }
        }
      }
    },
    "environment": { "$ref": "#/$defs/environment" },
    "faults": { "$ref": "#/$defs/faults" },
    "steps": {
      "type": "array",
      "minItems": 1,
      "maxItems": 30,
      "items": { "$ref": "#/$defs/step" }
    },
    "solution": {
      "description": "Lời giải mẫu, dùng để kiểm thử bài lab trước khi xuất bản. Mỗi bước có đúng một phần lời giải. Bước check dùng run. Bước answer dùng answer (câu trả lời viết sẵn) hoặc run (stdout của script là câu trả lời, dùng khi đáp án chỉ biết lúc chạy).",
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["step"],
        "oneOf": [{ "required": ["run"] }, { "required": ["answer"] }],
        "properties": {
          "step": { "$ref": "#/$defs/identifier" },
          "run": { "$ref": "#/$defs/script" },
          "answer": { "description": "Mẫu. Câu trả lời đúng của bước answer.", "type": "string", "minLength": 1, "maxLength": 200 }
        }
      }
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[a-z][a-zA-Z0-9_]{0,39}$"
    },
    "machine": {
      "description": "Tên máy trong môi trường. Phiên bản hiện tại chỉ có máy 'main'; môi trường nhiều máy (R14) mở rộng danh sách này (ADR-0015).",
      "enum": ["main"],
      "default": "main"
    },
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
      "maxLength": 64
    },
    "script": {
      "description": "Mẫu. Script shell POSIX.",
      "type": "string",
      "minLength": 1,
      "maxLength": 16384
    },
    "markdown": {
      "description": "Mẫu. Văn bản Markdown.",
      "type": "string",
      "maxLength": 8192
    },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["slug", "title", "difficulty", "estimatedMinutes"],
      "properties": {
        "slug": { "$ref": "#/$defs/slug" },
        "title": { "type": "string", "minLength": 3, "maxLength": 120 },
        "summary": { "type": "string", "maxLength": 500 },
        "language": {
          "description": "Ngôn ngữ của nội dung bài lab (tiêu đề, mô tả, gợi ý, thông điệp). Nội dung không được dịch; giao diện quanh bài lab theo ngôn ngữ của người dùng.",
          "enum": ["vi", "en"],
          "default": "vi"
        },
        "tags": {
          "type": "array",
          "maxItems": 10,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/slug" }
        },
        "difficulty": { "enum": ["BEGINNER", "INTERMEDIATE", "ADVANCED"] },
        "estimatedMinutes": { "type": "integer", "minimum": 5, "maximum": 180 }
      }
    },
    "param": {
      "description": "Đúng một bộ sinh cho mỗi tham số.",
      "type": "object",
      "minProperties": 1,
      "maxProperties": 1,
      "additionalProperties": false,
      "properties": {
        "pick": {
          "description": "Chọn một giá trị trong danh sách.",
          "type": "array",
          "minItems": 2,
          "maxItems": 100,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[A-Za-z0-9._/:@-]{1,64}$" }
        },
        "range": {
          "description": "Số nguyên trong đoạn [min, max].",
          "type": "object",
          "additionalProperties": false,
          "required": ["min", "max"],
          "properties": {
            "min": { "type": "integer" },
            "max": { "type": "integer" }
          }
        },
        "pattern": {
          "description": "Chuỗi ngẫu nhiên có độ dài cố định từ một tập ký tự, có thể kèm tiền tố.",
          "type": "object",
          "additionalProperties": false,
          "required": ["charset", "length"],
          "properties": {
            "charset": { "enum": ["lower", "lower-digit", "alnum", "hex"] },
            "length": { "type": "integer", "minimum": 4, "maximum": 32 },
            "prefix": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,15}$" }
          }
        },
        "subnet": {
          "description": "Một mạng con có độ dài tiền tố prefix nằm trong dải riêng cidr.",
          "type": "object",
          "additionalProperties": false,
          "required": ["cidr", "prefix"],
          "properties": {
            "cidr": { "type": "string", "pattern": "^(10|172|192)\\.[0-9]{1,3}\\.[0-9]{1,3}\\.[0-9]{1,3}/[0-9]{1,2}$" },
            "prefix": { "type": "integer", "minimum": 16, "maximum": 30 }
          }
        }
      }
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["image", "profile", "ttlMinutes"],
      "properties": {
        "image": {
          "description": "Image thuộc registry được phép (CR-DOC-05), gắn tag phiên bản cố định.",
          "type": "string",
          "pattern": "^ghcr\\.io/[a-z0-9-]+/crucible-labs/[a-z0-9-]+:[0-9]+\\.[0-9]+\\.[0-9]+$"
        },
        "profile": {
          "description": "Mức tài nguyên do M1 định nghĩa (CR-DOC-04 mục 10): small = 256 MiB bộ nhớ, CPU yêu cầu 0,1 vCPU, tối đa 1 vCPU; medium = 512 MiB, CPU yêu cầu 0,2 vCPU, tối đa 2 vCPU.",
          "enum": ["small", "medium"]
        },
        "ttlMinutes": { "type": "integer", "minimum": 10, "maximum": 180 },
        "maxExtensionMinutes": { "type": "integer", "minimum": 0, "maximum": 60, "default": 30 },
        "idleMinutes": { "type": "integer", "minimum": 5, "maximum": 60, "default": 15 },
        "network": {
          "description": "none: không truy cập ra ngoài; mirror: chỉ truy cập máy chủ gói nội bộ.",
          "enum": ["none", "mirror"],
          "default": "none"
        },
        "cpuIntensive": {
          "description": "Bài lab có thao tác dùng CPU cao kéo dài có chủ đích (biên dịch, nén); phiên không bị giám sát CPU bất thường (CR-MOD-M1 BR-M1.22).",
          "type": "boolean",
          "default": false
        },
        "capabilities": {
          "description": "Capability Linux bổ sung cho môi trường, chỉ cấp khi phiên chạy trong gVisor (ADR-0016). NET_ADMIN: cấu hình tường lửa, địa chỉ và định tuyến bên trong môi trường.",
          "type": "array",
          "uniqueItems": true,
          "items": { "enum": ["NET_ADMIN"] },
          "default": []
        },
        "files": {
          "type": "array",
          "maxItems": 20,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path", "content"],
            "properties": {
              "path": { "type": "string", "pattern": "^/(?!opt/crucible/)[A-Za-z0-9._/-]+$" },
              "content": { "type": "string", "maxLength": 65536, "description": "Mẫu." },
              "mode": { "type": "string", "pattern": "^0[0-7]{3}$", "default": "0644" }
            }
          }
        },
        "setup": { "$ref": "#/$defs/script" }
      }
    },
    "faults": {
      "description": "Lỗi cài sẵn: chọn 'pick' lỗi khác nhau từ danh sách theo seed, chạy sau setup.",
      "type": "object",
      "additionalProperties": false,
      "required": ["pick", "from"],
      "properties": {
        "pick": { "type": "integer", "minimum": 1, "maximum": 3 },
        "from": {
          "type": "array",
          "minItems": 2,
          "maxItems": 20,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "description", "inject"],
            "properties": {
              "id": { "$ref": "#/$defs/identifier" },
              "description": { "type": "string", "maxLength": 500, "description": "Chỉ hiển thị cho giảng viên." },
              "machine": { "$ref": "#/$defs/machine" },
              "inject": { "$ref": "#/$defs/script" }
            }
          }
        }
      }
    },
    "step": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "description", "points"],
      "if": { "required": ["type"], "properties": { "type": { "const": "answer" } } },
      "then": { "required": ["answer"], "not": { "anyOf": [{ "required": ["check"] }, { "required": ["expectInitially"] }] } },
      "else": { "required": ["check"], "not": { "anyOf": [{ "required": ["answer"] }, { "required": ["answerFirst"] }] } },
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "type": {
          "description": "check: đạt khi lệnh kiểm tra thành công trên môi trường; answer: học viên nhập câu trả lời, so với đáp án (CR-DOC-03 mục 4.6).",
          "enum": ["check", "answer"],
          "default": "check"
        },
        "title": { "type": "string", "minLength": 3, "maxLength": 120 },
        "description": { "$ref": "#/$defs/markdown" },
        "points": { "type": "integer", "minimum": 0, "maximum": 100 },
        "machine": { "$ref": "#/$defs/machine" },
        "answerFirst": {
          "description": "Chỉ với bước type: answer. Học viên phải nộp câu trả lời của bước này (đúng hay sai) trước khi kiểm tra được các bước check; chấm cuối vẫn chấm mọi bước.",
          "type": "boolean",
          "default": false
        },
        "answer": {
          "description": "Chỉ với bước type: answer. Tự luận: khai báo ít nhất một trong accepted, regex, from. Trắc nghiệm: khai báo choices cùng đúng một trong correct, correctFromFaults.",
          "type": "object",
          "additionalProperties": false,
          "oneOf": [
            {
              "anyOf": [{ "required": ["accepted"] }, { "required": ["regex"] }, { "required": ["from"] }],
              "not": { "anyOf": [{ "required": ["choices"] }, { "required": ["correct"] }, { "required": ["correctFromFaults"] }, { "required": ["multiple"] }] }
            },
            {
              "required": ["choices"],
              "oneOf": [{ "required": ["correct"] }, { "required": ["correctFromFaults"] }],
              "not": { "anyOf": [{ "required": ["accepted"] }, { "required": ["regex"] }, { "required": ["from"] }, { "required": ["caseSensitive"] }, { "required": ["placeholder"] }] }
            }
          ],
          "properties": {
            "choices": {
              "description": "Trắc nghiệm: các phương án hiển thị cho học viên theo thứ tự xáo trộn theo seed.",
              "type": "array",
              "minItems": 2,
              "maxItems": 10,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["id", "label"],
                "properties": {
                  "id": { "$ref": "#/$defs/identifier" },
                  "label": { "description": "Mẫu.", "type": "string", "minLength": 1, "maxLength": 200 }
                }
              }
            },
            "multiple": {
              "description": "Cho chọn nhiều phương án; điểm theo từng phương án (CR-DOC-03 mục 4.6).",
              "type": "boolean",
              "default": false
            },
            "correct": {
              "description": "Mã các phương án đúng.",
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": { "$ref": "#/$defs/identifier" }
            },
            "correctFromFaults": {
              "description": "Phương án đúng là các lỗi cài sẵn được chọn cho biến thể; mã phương án trùng mã lỗi.",
              "const": true
            },
            "accepted": {
              "description": "Mẫu. Các đáp án được chấp nhận.",
              "type": "array",
              "minItems": 1,
              "maxItems": 10,
              "items": { "type": "string", "minLength": 1, "maxLength": 200 }
            },
            "regex": {
              "description": "Mẫu. Biểu thức chính quy (cú pháp RE2) phải khớp toàn bộ câu trả lời đã chuẩn hóa.",
              "type": "string",
              "minLength": 1,
              "maxLength": 500
            },
            "from": {
              "description": "Đáp án lấy từ trạng thái môi trường tại thời điểm trả lời: stdout của lệnh, bỏ khoảng trắng đầu cuối. Dùng cho giá trị không biết trước như PID.",
              "type": "object",
              "additionalProperties": false,
              "required": ["run"],
              "properties": {
                "run": { "description": "Mẫu. Chạy như lệnh kiểm tra.", "type": "string", "minLength": 1, "maxLength": 4096 },
                "timeoutSeconds": { "type": "integer", "minimum": 1, "maximum": 15, "default": 5 }
              }
            },
            "caseSensitive": { "type": "boolean", "default": false },
            "maxTries": {
              "description": "Số lần trả lời tối đa khi học viên được xem kết quả (chế độ FULL). Mặc định 3 với tự luận, 1 với trắc nghiệm.",
              "type": "integer",
              "minimum": 1,
              "maximum": 10
            },
            "placeholder": { "description": "Gợi ý định dạng trong ô nhập, ví dụ 'Địa chỉ IPv4'.", "type": "string", "maxLength": 80 }
          }
        },
        "check": {
          "type": "object",
          "additionalProperties": false,
          "required": ["run"],
          "properties": {
            "run": {
              "description": "Mẫu. Chạy bằng /opt/crucible/bin/sh với PATH chỉ gồm /opt/crucible/bin. Mã thoát 0 là đạt.",
              "type": "string",
              "minLength": 1,
              "maxLength": 4096
            },
            "timeoutSeconds": { "type": "integer", "minimum": 1, "maximum": 15, "default": 5 },
            "successMessage": { "type": "string", "maxLength": 300 },
            "failureMessage": { "type": "string", "maxLength": 300, "description": "Mẫu." }
          }
        },
        "hints": {
          "type": "array",
          "maxItems": 5,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["text", "penalty"],
            "properties": {
              "text": { "$ref": "#/$defs/markdown" },
              "penalty": {
                "description": "Tỉ lệ điểm của bước bị trừ khi mở gợi ý này.",
                "type": "number",
                "minimum": 0,
                "maximum": 1
              }
            }
          }
        },
        "expectInitially": {
          "description": "Kết quả mong đợi của lệnh kiểm tra trên môi trường mới dựng khi kiểm thử bài lab; any dùng cho bước có kết quả ban đầu phụ thuộc lỗi cài sẵn được chọn.",
          "enum": ["fail", "pass", "any"],
          "default": "fail"
        }
      }
    }
  }
}
